{
  "name": "@ginno/mod-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Per-mod thin hooks runner for the Ginno Claude Code Mods compatibility layer",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "dist/mod-runner.mjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --legal-comment=inline --outfile=dist/mod-runner.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
