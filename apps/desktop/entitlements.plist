<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Webview JS eval (CSP 'unsafe-eval') and any in-page JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Python / native libs may allocate executable memory. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The PyInstaller sidecar ships ad-hoc-signed .dylib/.so that don't share
         a team id; library validation would otherwise refuse to load them and
         the sidecar fails to start (port never binds -> webview white-screens). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
