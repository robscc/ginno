{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ginno",
  "version": "0.1.0",
  "identifier": "io.ginno.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:8787",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @ginno/web dev",
    "beforeBuildCommand": "pnpm --filter @ginno/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Ginno",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' tauri: asset: http://127.0.0.1:8787 ws://127.0.0.1:8787 http://localhost:8787 ws://localhost:8787; style-src 'self' 'unsafe-inline' tauri: asset:; img-src 'self' data: tauri: asset:; script-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "resources": ["resources/runtime"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
