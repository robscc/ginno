{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ginno",
  "version": "0.1.0",
  "identifier": "io.ginno.desktop",
  "build": {
    "frontendDist": "../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @ginno/web dev",
    "beforeBuildCommand": "pnpm --filter @ginno/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Ginno",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "devUrl": "http://localhost:3000",
      "frontendDist": "../web/out"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/ginno-runtime"],
    "resources": []
  }
}
