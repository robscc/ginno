# Split-origin dev: `next dev` serves the UI on :3000 while the sidecar (API +
# /api/ws) runs on :8787. The web client derives its API base from
# window.location.origin (same-origin design), which in split-origin dev would
# resolve to :3000/api and 404 (Next has no proxy, output is a static export).
# Setting this makes the base point at the sidecar — exactly the pre-"same-origin"
# behaviour — so `pnpm dev:web` + `pnpm dev:runtime` and `tauri dev` work again.
# Loaded ONLY by `next dev`; production builds (served by the sidecar, same
# origin) ignore this file and keep using window.location.origin.
NEXT_PUBLIC_RUNTIME_PORT=8787
